  "requirements": [
    {
      "id": "krea2",
      "name": "Krea2 diffusion model",
      "category": "diffusion_models",
      "default_asset": "krea2_turbo_fp8",
      "description": "Creates image detail. Compatible installed Krea2 variants can replace Turbo. Sampler settings stay as supplied in the workflows; other variants may need different steps or CFG.",
      "binding": {
        "type": "KCPP_PromptStudioModelLoader",
        "field": "unet_name",
        "index": 1
      }
    },
    {
      "id": "encoder",
      "name": "Qwen3-VL 4B text and vision encoder",
      "category": "text_encoders",
      "default_asset": "qwen3vl_4b_bf16",
      "alternatives": [
        "qwen3vl_4b_fp8"
      ],
      "description": "Reads prompts and edit reference images. Reuses either supported BF16 or FP8 weights across all three workflows.",
      "binding": {
        "type": "CLIPLoader",
        "field": "clip_name",
        "index": 0
      }
    },
    {
      "id": "vae",
      "name": "Qwen Image VAE",
      "category": "vae",
      "default_asset": "qwen_image_vae",
      "description": "Converts between images and diffusion latents.",
      "binding": {
        "type": "VAELoader",
        "field": "vae_name",
        "index": 0
      }
    },
    {
      "id": "textfusion",
      "name": "Krea2 TextFusion LoRA",
      "category": "loras",
      "default_asset": "krea2_textfusion_refusal_reduction",
      "description": "The fixed LoRA included in your supplied workflows.",
      "binding": {
        "type": "LoraLoaderModelOnly",
        "field": "lora_name",
        "index": 0,
        "asset": "textfusion"
      }
    },
    {
      "id": "identity_edit",
      "name": "Krea2 Identity Edit v1.2 LoRA",
      "category": "loras",
      "default_asset": "krea2_identity_edit_v1_2",
      "description": "Provides instruction-based editing and reference identity preservation.",
      "binding": {
        "type": "LoraLoaderModelOnly",
        "field": "lora_name",
        "index": 0,
        "asset": "identity_edit"
      }
    },
    {
      "id": "upscaler",
      "name": "NMKD Superscale model",
      "category": "upscale_models",
      "default_asset": "nmkd_superscale",
      "description": "Provides the first enlargement pass for Ultimate SD Upscale.",
      "binding": {
        "type": "UpscaleModelLoader",
        "field": "model_name",
        "index": 0
      }
    },
    {
      "id": "qwen21",
      "name": "Qwen Image 2.1 diffusion model",
      "category": "diffusion_models",
      "default_asset": "qwen21_int8",
      "alternatives": [
        "qwen21_bf16"
      ],
      "description": "Shared by all Qwen 2.1 workflows. INT8 uses less memory; BF16 is also available.",
      "binding": {
        "type": "KCPP_PromptStudioModelLoader",
        "field": "unet_name",
        "index": 1
      }
    },
    {
      "id": "qwen21_encoder",
      "name": "Qwen3-VL 8B encoder",
      "category": "text_encoders",
      "default_asset": "qwen21_encoder_int8",
      "alternatives": [
        "qwen21_encoder_bf16"
      ],
      "description": "Reads prompts and reference images for Qwen 2.1. Shared by generation and editing.",
      "binding": {
        "type": "CLIPLoader",
        "field": "clip_name",
        "index": 0
      }
    },
    {
      "id": "qwen21_vae",
      "name": "Qwen Image 2.1 VAE",
      "category": "vae",
      "default_asset": "qwen21_vae_bf16",
      "description": "Native Qwen 2.1 decoder, including transparency. Separate from the VAE used by Krea2.",
      "binding": {
        "type": "VAELoader",
        "field": "vae_name",
        "index": 0
      }
    },
    {
      "id": "qwen21_turbo",
      "name": "Qwen 2.1 Turbo v0.3 LoRA",
      "category": "loras",
      "default_asset": "qwen21_viggle_turbo6",
      "description": "Required for Turbo v0.3 six-step workflows; applied once without merging into diffusion weights.",
      "binding": {
        "type": "KCPP_QwenImage21TurboLora",
        "field": "lora_name",
        "index": 0,
        "asset": "qwen21_turbo"
      }
    },
    {
      "id": "qwen21_controlnet",
      "name": "Qwen Image 2.1 Fun ControlNet Union",
      "category": "model_patches",
      "default_asset": "qwen21_controlnet"
    },
    {
      "id": "controlnet_depth",
      "name": "Depth Anything V2 Small",
      "category": "promptstudio_controlnet_aux",
      "default_asset": "controlnet_depth"
    },
    {
      "id": "controlnet_pose",
      "name": "DWPose pose estimator",
      "category": "promptstudio_controlnet_aux",
      "default_asset": "controlnet_pose"
    },
    {
      "id": "controlnet_person",
      "name": "DWPose person detector",
      "category": "promptstudio_controlnet_aux",
      "default_asset": "controlnet_person"
    },
    {
      "id": "controlnet_sketch",
      "name": "Lineart sketch extractor",
      "category": "promptstudio_controlnet_aux",
      "default_asset": "controlnet_sketch"
    },
    {
      "id": "controlnet_sketch_coarse",
      "name": "Lineart coarse extractor",
      "category": "promptstudio_controlnet_aux",
      "default_asset": "controlnet_sketch_coarse"
    }
  ],
  "node_packs": [
    {
      "id": "krea2edit",
      "name": "Krea2 Edit nodes",
      "classes": [
        "Krea2EditGroundedEncode",
        "Krea2EditModelPatch"
      ],
      "url": "https://github.com/lbouaraba/comfyui-krea2edit",
      "required_inputs": {
        "Krea2EditModelPatch": [
          "target_latent"
        ]
      }
    },
    {
      "id": "ultimate",
      "name": "Ultimate SD Upscale nodes",
      "classes": [
        "UltimateSDUpscale"
      ],
      "url": "https://github.com/ssitu/ComfyUI_UltimateSDUpscale"
    },
    {
      "id": "controlnet_aux",
      "name": "ControlNet Auxiliary Preprocessors",
      "registry_id": "comfyui_controlnet_aux",
      "url": "https://github.com/Fannovel16/comfyui_controlnet_aux",
      "classes": [
        "DWPreprocessor",
        "DepthAnythingV2Preprocessor",
        "LineArtPreprocessor"
      ]
    }
  ],
  "licenses": [
    {
      "name": "Krea2 model terms",
      "url": "https://huggingface.co/Comfy-Org/Krea-2/blob/main/LICENSE.pdf"
    },
    {
      "name": "TextFusion model card",
      "url": "https://huggingface.co/Quiho/Krea2_TextFusion_Refusal-Reduction_LoRA_v1.0_lora"
    },
    {
      "name": "NMKD Superscale source",
      "url": "https://huggingface.co/Kalashnikov/NMKD-superscale"
    },
    {
      "name": "Identity Edit model card",
      "url": "https://huggingface.co/conradlocke/krea2-identity-edit"
    },
    {
      "name": "Qwen Research License",
      "url": "https://huggingface.co/Qwen/Qwen-Image-2.1/blob/main/LICENSE"
    },
    {
      "name": "Viggle Turbo model card",
      "url": "https://huggingface.co/Viggle/Qwen-Image-2.1-viggle-turbo"
    }
  ],
  "addons": [
    {
      "id": "qwen21_controlnet",
      "name": "Qwen 2.1 Structure guide (ControlNet)",
      "description": "Pose, depth, edges or sketch guidance in Qwen Create and Edit. Edges and prepared maps need no extra extractor.",
      "requirements": [
        "qwen21_controlnet"
      ],
      "nodes": [],
      "classes": [
        "ModelPatchLoader",
        "ZImageFunControlnet",
        "KCPP_QwenStructureGuide"
      ],
      "license": {
        "id": "qwen-research-2026-09-20",
        "name": "Qwen Research License",
        "url": "https://huggingface.co/Qwen/Qwen-Image-2.1/blob/main/LICENSE",
        "notice": "Qwen Image 2.1 is restricted to strict non-commercial use: research or evaluation only. Commercial use requires a separate license from Qwen. Accept these terms to select this workflow."
      }
    },
    {
      "id": "controlnet_pose",
      "name": "Pose extraction",
      "description": "Detect people, body, hands and face with DWPose.",
      "requirements": [
        "controlnet_pose",
        "controlnet_person"
      ],
      "nodes": [
        "controlnet_aux"
      ],
      "classes": [
        "DWPreprocessor"
      ]
    },
    {
      "id": "controlnet_depth",
      "name": "Depth extraction",
      "description": "Extract scene depth with Depth Anything V2 Small (99 MB).",
      "requirements": [
        "controlnet_depth"
      ],
      "nodes": [
        "controlnet_aux"
      ],
      "classes": [
        "DepthAnythingV2Preprocessor"
      ]
    },
    {
      "id": "controlnet_sketch",
      "name": "Sketch extraction",
      "description": "Extract line drawings with Lineart.",
      "requirements": [
        "controlnet_sketch",
        "controlnet_sketch_coarse"
      ],
      "nodes": [
        "controlnet_aux"
      ],
      "classes": [
        "LineArtPreprocessor"
      ]
    }
  ]
}
