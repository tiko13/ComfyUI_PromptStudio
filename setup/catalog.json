{
  "version": 1,
  "packs": [
    {"id": "create", "name": "Create", "file": "[PS] - Krea2 Turbo.json", "requirements": ["krea2", "encoder", "vae", "textfusion"], "nodes": []},
    {"id": "edit", "name": "Edit", "file": "[PS] - Krea2 Turbo_Edit.json", "requirements": ["krea2", "encoder", "vae", "textfusion", "identity_edit"], "nodes": ["krea2edit"]},
    {"id": "upscale", "name": "Upscale", "file": "[PS] - Krea2 Upscale UltimateSD.json", "requirements": ["krea2", "encoder", "vae", "textfusion", "upscaler"], "nodes": ["krea2edit", "ultimate"]}
  ],
  "requirements": [
    {"id": "krea2", "name": "Krea2 diffusion model", "category": "diffusion_models", "default_asset": "krea2_turbo_fp8", "description": "Creates image detail. Compatible installed Krea2 variants can replace Turbo. Sampler settings stay as supplied in the workflows; other variants may need different steps or CFG.", "binding": {"type": "KCPP_PromptStudioModelLoader", "field": "unet_name", "index": 1}},
    {"id": "encoder", "name": "Qwen3-VL 4B text and vision encoder", "category": "text_encoders", "default_asset": "qwen3vl_4b_bf16", "alternatives": ["qwen3vl_4b_fp8"], "description": "Reads prompts and edit reference images. Reuses either supported BF16 or FP8 weights across all three workflows.", "binding": {"type": "CLIPLoader", "field": "clip_name", "index": 0}},
    {"id": "vae", "name": "Qwen Image VAE", "category": "vae", "default_asset": "qwen_image_vae", "description": "Converts between images and diffusion latents.", "binding": {"type": "VAELoader", "field": "vae_name", "index": 0}},
    {"id": "textfusion", "name": "Krea2 TextFusion LoRA", "category": "loras", "default_asset": "krea2_textfusion_refusal_reduction", "description": "The fixed LoRA included in your supplied workflows.", "binding": {"type": "LoraLoaderModelOnly", "field": "lora_name", "index": 0, "asset": "textfusion"}},
    {"id": "identity_edit", "name": "Krea2 Identity Edit v1.2 LoRA", "category": "loras", "default_asset": "krea2_identity_edit_v1_2", "description": "Provides instruction-based editing and reference identity preservation.", "binding": {"type": "LoraLoaderModelOnly", "field": "lora_name", "index": 0, "asset": "identity_edit"}},
    {"id": "upscaler", "name": "NMKD Superscale model", "category": "upscale_models", "default_asset": "nmkd_superscale", "description": "Provides the first enlargement pass for Ultimate SD Upscale.", "binding": {"type": "UpscaleModelLoader", "field": "model_name", "index": 0}}
  ],
  "node_packs": [
    {"id": "krea2edit", "name": "Krea2 Edit nodes", "classes": ["Krea2EditGroundedEncode", "Krea2EditModelPatch"], "url": "https://github.com/lbouaraba/comfyui-krea2edit", "required_inputs": {"Krea2EditModelPatch": ["target_latent"]}},
    {"id": "ultimate", "name": "Ultimate SD Upscale nodes", "classes": ["UltimateSDUpscale"], "url": "https://github.com/ssitu/ComfyUI_UltimateSDUpscale"}
  ],
  "licenses": [
