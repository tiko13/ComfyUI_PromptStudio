  "requirements": [
    {
      "id": "krea2",
      "name": "Krea2 diffusion model",
      "category": "diffusion_models",
      "default_asset": "krea2_turbo_fp8",
      "description": "Creates image detail. Compatible installed Krea2 variants can replace Turbo. Sampler settings stay as supplied in the workflows; other variants may need different steps or CFG.",
      "binding": {
        "type": "KCPP_PromptStudioModelLoader",
        "field": "unet_name",
        "index": 1
      }
    },
    {
      "id": "encoder",
      "name": "Qwen3-VL 4B text and vision encoder",
      "category": "text_encoders",
      "default_asset": "qwen3vl_4b_bf16",
      "alternatives": [
        "qwen3vl_4b_fp8"
      ],
      "description": "Reads prompts and reference images. Shared Qwen3-VL 4B BF16 or FP8 weights for Krea2 and FIBO 2; Setup reuses an installed compatible encoder.",
      "binding": {
        "type": "CLIPLoader",
        "field": "clip_name",
        "index": 0
      }
    },
    {
      "id": "vae",
      "name": "Qwen Image VAE",
      "category": "vae",
      "default_asset": "qwen_image_vae",
      "description": "Converts between images and diffusion latents.",
      "binding": {
        "type": "VAELoader",
        "field": "vae_name",
        "index": 0
      }
    },
    {
      "id": "textfusion",
      "name": "Krea2 TextFusion LoRA",
      "category": "loras",
      "default_asset": "krea2_textfusion_refusal_reduction",
      "description": "The fixed LoRA included in your supplied workflows.",
      "binding": {
        "type": "LoraLoaderModelOnly",
        "field": "lora_name",
        "index": 0,
        "asset": "textfusion"
      }
    },
    {
      "id": "identity_edit",
      "name": "Krea2 Identity Edit v1.2 LoRA",
      "category": "loras",
      "default_asset": "krea2_identity_edit_v1_2",
      "description": "Provides instruction-based editing and reference identity preservation.",
      "binding": {
        "type": "LoraLoaderModelOnly",
        "field": "lora_name",
        "index": 0,
        "asset": "identity_edit"
      }
    },
    {
      "id": "upscaler",
      "name": "NMKD Superscale model",
      "category": "upscale_models",
      "default_asset": "nmkd_superscale",
      "description": "Provides the first enlargement pass for Ultimate SD Upscale.",
      "binding": {
        "type": "UpscaleModelLoader",
        "field": "model_name",
        "index": 0
      }
    },
    {
      "id": "qwen21",
      "name": "Qwen Image 2.1 diffusion model",
      "category": "diffusion_models",
      "default_asset": "qwen21_int8",
      "alternatives": [
        "qwen21_bf16"
      ],
      "description": "Base25 and base40 diffusion model. INT8 uses less memory; BF16 is also available.",
      "binding": {
        "type": "KCPP_PromptStudioModelLoader",
        "field": "unet_name",
        "index": 1
      }
    },
    {
      "id": "qwen21_encoder",
      "name": "Qwen3-VL 8B encoder",
      "category": "text_encoders",
      "default_asset": "qwen21_encoder_int8",
      "alternatives": [
        "qwen21_encoder_bf16"
      ],
      "description": "Reads prompts and reference images for Qwen 2.1. Shared by generation and editing.",
      "binding": {
        "type": "CLIPLoader",
        "field": "clip_name",
        "index": 0
      }
    },
    {
      "id": "qwen21_vae",
      "name": "Qwen Image 2.1 VAE",
      "category": "vae",
      "default_asset": "qwen21_vae_bf16",
      "description": "Native Qwen 2.1 decoder, including transparency. Separate from the VAE used by Krea2.",
      "binding": {
        "type": "VAELoader",
        "field": "vae_name",
        "index": 0
      }
    },
    {
      "id": "qwen21_turbo",
      "name": "Qwen Image 2.1 Official Turbo INT8",
      "category": "diffusion_models",
      "default_asset": "qwen21_official_turbo_int8",
      "description": "Full Turbo checkpoint for the fixed official eight-step Euler schedule. No Turbo LoRA or base diffusion model required.",
      "binding": {
        "type": "KCPP_PromptStudioModelLoader",
        "field": "unet_name",
        "index": 1
      }
    },
    {
      "id": "qwen21_controlnet",
      "name": "Qwen Image 2.1 Fun ControlNet Union",
      "category": "model_patches",
      "default_asset": "qwen21_controlnet"
    },
    {
      "id": "controlnet_depth",
      "name": "Depth Anything V2 Small",
      "category": "promptstudio_controlnet_aux",
      "default_asset": "controlnet_depth"
    },
    {
      "id": "controlnet_pose",
      "name": "DWPose pose estimator",
      "category": "promptstudio_controlnet_aux",
      "default_asset": "controlnet_pose"
    },
    {
      "id": "controlnet_person",
      "name": "DWPose person detector",
      "category": "promptstudio_controlnet_aux",
      "default_asset": "controlnet_person"
    },
    {
      "id": "controlnet_sketch",
      "name": "Lineart sketch extractor",
      "category": "promptstudio_controlnet_aux",
      "default_asset": "controlnet_sketch"
    },
    {
      "id": "controlnet_sketch_coarse",
      "name": "Lineart coarse extractor",
      "category": "promptstudio_controlnet_aux",
      "default_asset": "controlnet_sketch_coarse"
    },
    {
      "id": "fibo2_dev",
      "name": "FIBO 2 Dev BF16",
      "category": "diffusion_models",
      "default_asset": "fibo2_dev_bf16",
      "description": "Full Dev checkpoint shared by Create and Edit. Defaults: 50 steps and CFG 5.",
      "binding": {
        "type": "KCPP_PromptStudioModelLoader",
        "field": "unet_name",
        "index": 1
      }
    },
    {
      "id": "fibo2_turbo",
      "name": "FIBO 2 Edit Turbo BF16",
      "category": "diffusion_models",
      "default_asset": "fibo2_edit_turbo_bf16",
      "description": "Full distilled editing checkpoint. Defaults: four steps and CFG 1; no Turbo LoRA required.",
      "binding": {
        "type": "KCPP_PromptStudioModelLoader",
        "field": "unet_name",
        "index": 1
      }
    },
    {
      "id": "fibo2_vae",
      "name": "Flux2 VAE",
      "category": "vae",
      "default_asset": "flux2_vae",
      "description": "Shared FIBO image/latent encoder and decoder. Reuses an existing matching Flux2 VAE.",
      "binding": {
        "type": "VAELoader",
        "field": "vae_name",
        "index": 0
      },
      "alternatives": [
        "flux2_vae_diffusers"
      ]
